{
  "$id": "https://contracts.2d-animation-studio.local/script_analysis.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$",
      "type": "string"
    },
    "channel_id": {
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$",
      "type": "string"
    },
    "continuity_notes": {
      "items": {
        "maxLength": 2000,
        "type": "string"
      },
      "maxItems": 500,
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "entities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "pattern": "^[a-z][a-z0-9_:-]{2,127}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "actor",
              "prop",
              "location"
            ]
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "entity_id",
          "kind",
          "name"
        ],
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "script_analysis.v1"
    },
    "script_artifact_id": {
      "pattern": "^[a-z][a-z0-9_:-]{2,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "channel_id",
    "project_id",
    "revision",
    "created_at",
    "script_artifact_id",
    "entities",
    "continuity_notes"
  ],
  "type": "object"
}
